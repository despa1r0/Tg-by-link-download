BOT_TOKEN=your_telegram_bot_token_here
# Optional: create ./secrets/cookies.txt on the Docker host, then uncomment.
# The file must use Netscape/Mozilla cookie-jar format.
# YTDLP_COOKIES_FILE=/app/secrets/cookies.txt
# The official cloud Telegram Bot API can upload at most 50 MB.
# Only raise this when the bot is configured to use a local Bot API server.
MAX_DOWNLOAD_MB=50
# Bound expensive background work so concurrent users do not overload the VPS.
YTDLP_CONCURRENCY=4
FFMPEG_CONCURRENCY=2
# Optional secret used to create stable, non-reversible user references in logs.
# Generate a long random value; raw Telegram user IDs are never logged.
# LOG_CONTEXT_SALT=replace-with-a-random-secret
LOG_LEVEL=INFO
# Loki is bound to localhost because it does not provide authentication itself.
LOKI_PORT=3100
# Production CI/CD overrides this with the immutable image tag it just built.
# BOT_IMAGE=ghcr.io/despa1r0/tg-by-link-download:latest
